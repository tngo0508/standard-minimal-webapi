@baseUrl = http://localhost:5106
@email = demo@example.test
@password = ChangeMe-123!

### Register
POST {{baseUrl}}/auth/register
Content-Type: application/json

{ "email": "{{email}}", "password": "{{password}}" }

### Login (captures the token for the requests below)
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "{{email}}", "password": "{{password}}" }

### Refresh (single-use: run Login again before repeating this)
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{ "refreshToken": "{{login.response.body.refreshToken}}" }

### Logout (revokes the refresh token)
POST {{baseUrl}}/auth/logout
Content-Type: application/json

{ "refreshToken": "{{login.response.body.refreshToken}}" }

### Who am I
GET {{baseUrl}}/auth/me
Authorization: Bearer {{login.response.body.accessToken}}

### List categories
GET {{baseUrl}}/categories
Authorization: Bearer {{login.response.body.accessToken}}

### Create category
POST {{baseUrl}}/categories
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{ "name": "Tools" }

### Rename category
PUT {{baseUrl}}/categories/1
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{ "name": "Hand tools" }

### Delete category (its products become uncategorised)
DELETE {{baseUrl}}/categories/1
Authorization: Bearer {{login.response.body.accessToken}}

### List products in one category
GET {{baseUrl}}/products?categoryId=1
Authorization: Bearer {{login.response.body.accessToken}}

### List products
GET {{baseUrl}}/products
Authorization: Bearer {{login.response.body.accessToken}}

### Create product
POST {{baseUrl}}/products
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{ "name": "Widget", "price": 9.99, "categoryId": 1 }

### Update product
PUT {{baseUrl}}/products/1
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{ "name": "Widget v2", "price": 12.50 }

### Delete product
DELETE {{baseUrl}}/products/1
Authorization: Bearer {{login.response.body.accessToken}}
